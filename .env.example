VITE_GOOGLE_CLIENT_ID=

# Optional: where the SQLite database file is stored. Defaults to
# server/data/careshare.db. This project folder is OneDrive-synced, which
# has silently corrupted generated files before (see HANDOVER.md) — set this
# to a path outside any synced folder, e.g. ~/.careshare/careshare.db, if
# you hit odd database errors.
CARESHARE_DB_PATH=
